# ========================================================================
# 🏠 KSIT MOBILE PRODUCTION CONFIGURATION
# ========================================================================

# Application Configuration
APP_NAME=e-menu-owner
EXTERNAL_PORT=9443
PORT=3443
PM2_STARTUP=true
SERVER_IP=152.42.254.193

# ========================================================================
# 🔐 Git Configuration - GitHub with Personal Access Token
# ========================================================================
GIT_USERNAME=Phatmenghor
GIT_PASSWORD=
GIT_REPO_URL=https://github.com/Phatmenghor/menu-scanner-frontend-owner.git
GIT_BRANCH=development

# ========================================================================
# 🌐 Next.js Environment Variables
# ========================================================================
NODE_ENV=production
NEXT_PUBLIC_NODE_ENV=production

# ========================================================================
# 🔗 API Configuration - NGINX PROXY SETUP
# Frontend calls: http://152.42.254.193:9443/api/* → nginx → backend:7000
# ========================================================================

BACKEND_API_URL=http://152.42.254.193:8080
NEXT_PUBLIC_API_BASE_URL=http://152.42.254.193:9443/api
NEXT_PUBLIC_API_BASE_URL_IMAGE=http://152.42.254.193:9443

# ========================================================================
# ⚡ Performance Settings
# ========================================================================
NODE_OPTIONS=--max-old-space-size=1024
ENABLE_HOT_RELOAD=false
ENABLE_SOURCE_MAPS=false

# ========================================================================
# 🔧 Build Configuration
# ========================================================================
NEXT_TELEMETRY_DISABLED=1
ANALYZE=false

# ========================================================================
# 📊 Logging Configuration
# ========================================================================
LOG_LEVEL=info
DEBUG_MODE=false

# ========================================================================
# 🛡️ Security Configuration
# ========================================================================
SECURE_COOKIES=true
TRUST_PROXY=true

# ========================================================================
# 📱 Application URLs (for reference)
# ========================================================================
# Frontend:    http://152.42.254.193:9443
# Backend:     http://152.42.254.193:8080
# Swagger:     http://152.42.254.193:8080/swagger-ui/swagger-ui/index.html
# API Flow:    Frontend → 9443/api/* → nginx proxy → 8080/api/*
# Images:      Frontend → 9443/uploads/* → nginx proxy → 8080/uploads/*
# ========================================================================